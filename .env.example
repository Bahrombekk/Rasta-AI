# Rasta AI — muhit o'zgaruvchilari namunasi.
# Nusxa oling: cp .env.example .env  — va qiymatlarni to'ldiring.
# Haqiqiy sirlarni (.env) hech qachon gitga qo'ymang.

# --- Tarmoq ---
# Lokal: 127.0.0.1 (faqat shu mashina). Ommaviy server: 0.0.0.0
RASTA_BIND=127.0.0.1
RASTA_PORT=8090

# --- Domen (Caddy + avtomatik HTTPS) ---
# Caddy shu domen uchun Let's Encrypt SSL sertifikatini avtomatik oladi va
# 80/443 portlarini tinglaydi (ichki frontend:8080 ga uzatadi). Domen DNS'i
# shu server IP'siga ishora qilishi va 80/443 portlari ochiq bo'lishi shart.
RASTA_DOMAIN=rastaai.uz

# --- Ichki AI servis tokeni (MAJBURIY) ---
# backend va ai konteynerlari o'rtasidagi umumiy sir. Tasodifiy qiymat yarating:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
RASTA_AI_TOKEN=

# --- Cookie xavfsizligi ---
# HTTPS (prod) ortida 1 qiling. Eslatma: so'rov HTTPS orqali kelsa cookie
# avtomatik ham Secure bo'ladi, lekin prodda buni ANIQ 1 qilish tavsiya etiladi.
RASTA_SECURE_COOKIES=0

# --- Ma'lumotlar bazasi ---
# SQLite (standart, bir-serverli): quyidagilarni bo'sh qoldiring — backend
#   /app/data/accounts/users.sqlite3 dan foydalanadi (volume'da saqlanadi).
# PostgreSQL (compose.postgres.yml bilan): ikkalasini ham to'ldiring.
#   Parolda maxsus belgilar bo'lsa URL'da kodlang (masalan @ -> %40).
# RASTA_POSTGRES_PASSWORD=
# RASTA_DATABASE_URL=postgresql://rasta:URL_ENCODED_PASSWORD@postgres:5432/rasta

# --- Admin (ixtiyoriy) ---
# Hisoblar tizimi yoqilganda (RASTA_WORKSPACES=1) odatda shart emas.
# RASTA_ADMIN_PASSWORD=
# XAVFLI: admin'ni parolsiz ochadi — PRODDA O'RNATMANG (bo'sh qoldiring).
# RASTA_ADMIN_OPEN=

# Eslatma: RASTA_WORKSPACES=1 (ko'p-korxona rejimi) docker-compose.yml da
# allaqachon o'rnatilgan — bu yerda kerak emas.
