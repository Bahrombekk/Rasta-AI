FROM python:3.10-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.backend.txt .
RUN python -m pip install --no-cache-dir -r requirements.backend.txt
COPY config.yaml .
COPY src/ src/
COPY scripts/_bootstrap.py scripts/serve.py scripts/manage_users.py scripts/
EXPOSE 8000
CMD ["python", "scripts/serve.py", "--host", "0.0.0.0", "--port", "8000", "--api-only"]
